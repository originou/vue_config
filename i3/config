# i3 config (v4), Debian 12 (i3 4.22). Linked to ~/.config/i3/config by install.sh, with the
# helper scripts next to it.

set $mod Mod4
set $alt Mod1

font pango:JetBrainsMono Nerd Font Bold 11
title_align center
for_window [all] title_window_icon padding 4px

floating_modifier $mod
focus_follows_mouse no

bindsym $mod+Return exec alacritty
bindsym $mod+Shift+q kill
bindsym $mod+d exec rofi -show drun

# Change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move the focused window (floating: to the next screen's workspace, move-dir.sh)
bindsym $mod+Shift+h exec --no-startup-id ~/.config/i3/move-dir.sh left
bindsym $mod+Shift+j exec --no-startup-id ~/.config/i3/move-dir.sh down
bindsym $mod+Shift+k exec --no-startup-id ~/.config/i3/move-dir.sh up
bindsym $mod+Shift+l exec --no-startup-id ~/.config/i3/move-dir.sh right
bindsym $mod+Shift+Left exec --no-startup-id ~/.config/i3/move-dir.sh left
bindsym $mod+Shift+Down exec --no-startup-id ~/.config/i3/move-dir.sh down
bindsym $mod+Shift+Up exec --no-startup-id ~/.config/i3/move-dir.sh up
bindsym $mod+Shift+Right exec --no-startup-id ~/.config/i3/move-dir.sh right

# Move the whole workspace to another screen
bindsym $mod+Ctrl+Shift+Right move workspace to output right
bindsym $mod+Ctrl+Shift+Left  move workspace to output left
bindsym $mod+Ctrl+Shift+Up    move workspace to output up
bindsym $mod+Ctrl+Shift+Down  move workspace to output down

bindsym $mod+bar split h
bindsym $mod+v split v
bindsym $mod+f fullscreen

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Toggle tiling / floating, with the matching border (float-toggle.sh)
bindsym $mod+Shift+space exec --no-startup-id ~/.config/i3/float-toggle.sh
# Back to the previously focused window (focus-last.sh)
bindsym $mod+Tab exec --no-startup-id ~/.config/i3/focus-last.sh --switch
bindsym $mod+space focus mode_toggle

# Scratchpad menu: minimize / restore the floating windows of the workspace
bindsym $mod+Shift+minus exec --no-startup-id ~/.config/i3/minimize-menu.sh
# Minimize the focused window, if it's floating
bindsym $mod+minus exec --no-startup-id ~/.config/i3/popup-scratchpad-toggle.sh --current

bindsym $mod+a focus parent

# Workspaces
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# Lock, screenshot of a region (file + clipboard)
bindsym $alt+Shift+l exec --no-startup-id i3lock -e -f -c 1e1e2e
bindsym $alt+Shift+s exec --no-startup-id bash -c 'mkdir -p ~/Pictures/screenshots && maim -s | tee ~/Pictures/screenshots/$(date +%Y-%m-%d_%H-%M-%S).png | xclip -selection clipboard -t image/png'

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3? This ends your X session.' -b 'Yes, exit i3' 'i3-msg exit'"

mode "resize" {
        # Left / Right: small steps (50 px), Up / Down: big ones (200 px), both axes at once
        bindsym Left resize shrink width 50 px or 5 ppt, resize shrink height 50 px or 5 ppt
        bindsym Right resize grow width 50 px or 5 ppt, resize grow height 50 px or 5 ppt
        bindsym Up resize shrink width 200 px or 20 ppt, resize shrink height 200 px or 20 ppt
        bindsym Down resize grow width 200 px or 20 ppt, resize grow height 200 px or 20 ppt
        bindsym h resize shrink width 50 px or 5 ppt, resize shrink height 50 px or 5 ppt
        bindsym l resize grow width 50 px or 5 ppt, resize grow height 50 px or 5 ppt
        bindsym k resize shrink width 200 px or 20 ppt, resize shrink height 200 px or 20 ppt
        bindsym j resize grow width 200 px or 20 ppt, resize grow height 200 px or 20 ppt

        bindsym Shift+Left move left 500 px
        bindsym Shift+Down move down 500 px
        bindsym Shift+Up move up 500 px
        bindsym Shift+Right move right 500 px

        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

mode "move" {
        bindsym Left move left 20 px
        bindsym Down move down 20 px
        bindsym Up move up 20 px
        bindsym Right move right 20 px
        bindsym Shift+Left move left 200 px
        bindsym Shift+Down move down 200 px
        bindsym Shift+Up move up 200 px
        bindsym Shift+Right move right 200 px
        bindsym c move position center
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+m mode "move"

# Audio
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

# Autostart
exec_always --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id bash ~/.config/polybar/launch.sh
exec_always --no-startup-id bash ~/.config/i3/popup-placer.sh
exec_always --no-startup-id bash ~/.config/i3/focus-last.sh
exec_always --no-startup-id ~/.config/i3/wallpaper.sh
exec --no-startup-id picom
exec --no-startup-id dunst
# Caps Lock = an extra Super key (Win stays Super): Caps+hjkl reaches i3 while Windows (Citrix
# host) keeps Win+L for its lock screen. -option '' clears the previous options first.
# exec_always: re-applied on i3 restart (a Citrix reconnect may reset the keyboard options)
exec_always --no-startup-id setxkbmap -option '' -option caps:super

# Look: thin border on tiled windows, title bar + 8 px border on floating ones
default_border pixel 1
default_floating_border normal 8

# border colors:          border   bg       text     indicator child_border
set $accent        #88C0D0
set $card          #313244
client.focused            $card    $card    $accent  $accent   $card
client.unfocused          #1e1e2e  #1e1e2e  #6c7086  #1e1e2e   #1e1e2e
client.focused_inactive   #252536  #252536  #9399b2  #252536   #252536
client.urgent             #f38ba8  #f38ba8  #1e1e2e  #f38ba8   #f38ba8

# Floating terminal popups (term-popup.sh)
for_window [class="AlacrittyPopup"] floating enable, resize set 1600 900, move position center, border normal 8

gaps outer 3px
gaps inner 8px
