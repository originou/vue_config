# zsh, linked to ~/.zshrc by install.sh (oh-my-zsh and its plugins cloned by it too).

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
DISABLE_UNTRACKED_FILES_DIRTY="true"

plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  kubectl
  tmux
  zsh-fzf-history-search
)

# Binaries outside apt (nvim, lazygit, node...) and the Mason ones
export PATH="$HOME/.local/bin:$HOME/.local/share/nvim/mason/bin:$PATH"
export EDITOR=nvim

source "$ZSH/oh-my-zsh.sh"
[ -f ~/.profile ] && source ~/.profile

DEFAULT_USER=$(whoami)
RPROMPT="[%D{%y/%m/%f}|%@]"

command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

alias n="nvim"
alias lgit="lazygit"

# Machine-specific settings (proxy, work aliases...), not in git
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
